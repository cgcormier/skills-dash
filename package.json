{
  "name": "skill-archive",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420 --strictPort",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "preview": "vite preview --host 127.0.0.1 --port 1420",
    "tauri": "tauri",
    "desktop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/desktop.ps1 dev",
    "desktop:build": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/desktop.ps1 build",
    "desktop:test": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/desktop.ps1 test",
    "profile:init": "tsx scripts/init-improvement-profile.ts",
    "report:use": "tsx scripts/report-use.ts",
    "test:live": "tsx scripts/live-reviewer-smoke.ts"
  },
  "dependencies": {
    "@fontsource/anton": "^5.2.7",
    "@fontsource/ibm-plex-mono": "^5.2.7",
    "@fontsource/inter": "^5.2.8",
    "@tauri-apps/api": "^2.10.1",
    "lucide-react": "^0.577.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.10.1",
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "5.0.4",
    "axe-core": "4.11.1",
    "prettier": "3.6.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "7.3.7",
    "vitest": "4.1.12"
  }
}

{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Skill Archive",
  "version": "0.1.0",
  "identifier": "com.skillarchive.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Personal Skills — Workbench",
        "width": 1100,
        "height": 720,
        "minWidth": 375,
        "minHeight": 600,
        "decorations": false,
        "resizable": true,
        "maximized": true,
        "backgroundColor": "#151514"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'",
      "capabilities": ["main"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "shortDescription": "Inspect your personal agent skill files.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.ico"]
  }
}
